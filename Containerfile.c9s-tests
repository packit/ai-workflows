FROM quay.io/centos/centos:stream9

RUN dnf -y install epel-release \
    && dnf config-manager --set-enabled crb \
    && dnf -y update

RUN dnf -y install --allowerasing \
      curl \
      gcc \
      gcc-c++ \
      git \
      krb5-devel \
      libpq-devel \
      python3-rpm \
      rpm-build \
      rpmdevtools \
      rpmautospec-rpm-macros \
      rpmlint \
      tmt \
      python3.11 \
      python3.11-pip \
      python3.11-devel \
    && dnf clean all

# Create Python 3.11 virtual environment and install Python packages
RUN python3.11 -m venv --system-site-packages /opt/beeai-venv \
    && /opt/beeai-venv/bin/pip install --upgrade pip \
    && /opt/beeai-venv/bin/pip install --no-cache-dir \
       "litellm!=1.82.7,!=1.82.8,!=1.92.0,!=1.107.0" \
       "beeai-framework[vertexai,mcp,duckduckgo] @ https://github.com/i-am-bee/beeai-framework/archive/e7ef6091360e54d18c298d4fc2a6ed8e8d1205bc.tar.gz#subdirectory=python" \
       openinference-instrumentation-beeai==0.1.21 \
       arize-phoenix-otel \
       aiohttp>=3.12.15 \
       redis \
       sentry-sdk \
       specfile \
       pytest \
       pytest-asyncio \
       flexmock \
       koji \
       rpkg \
       GitPython \
       nitrate \
       tomli-w \
       "logdetective-mcp>=0.5.0" \
       typer \
       python-dotenv

# Verify no malicious litellm_init.pth was introduced by compromised litellm packages.
RUN MALICIOUS=$(find /usr /opt -name "litellm_init.pth" 2>/dev/null); \
    if [ -n "$MALICIOUS" ]; then \
      echo "SECURITY ALERT: malicious litellm_init.pth detected: $MALICIOUS"; \
      exit 1; \
    fi

# Make venv Python the default
ENV PATH=/opt/beeai-venv/bin:$PATH

RUN git config --global user.email "ymir-tests@example.com" \
      && git config --global user.name "Ymir Tests"

# Set PYTHONPATH so ymir namespace package can be imported
ENV PYTHONPATH=/src:$PYTHONPATH

WORKDIR /src
