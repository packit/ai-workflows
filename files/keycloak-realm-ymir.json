{
  "realm": "ymir",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "ymir-trace-ui",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8082/*"
      ],
      "webOrigins": [
        "http://localhost:8082"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "openid",
        "email",
        "profile"
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "testuser@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ]
    }
  ]
}
