# gitlab.com -> Edit profile -> Access tokens -> Add new token
# Permissions: read_user, read_repository, read_virtual_registry, write_repository, api, read_api, write_api
# write access may delete information and it should be only used in test environments.
GITLAB_TOKEN=

JIRA_URL=https://redhat.atlassian.net
# Jira account email for authentication
JIRA_EMAIL=
# Jira API token - https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=

# Build backend: "konflux" (Compose default) or "copr". See docs/konflux-backend.md.
BUILD_BACKEND=konflux

# --- Konflux build backend (only needed when BUILD_BACKEND=konflux) ---
# See docs/konflux-backend.md. The SA token is NOT set here: it is read per
# build from the file mounted at KONFLUX_TOKEN_FILE (compose.yaml mounts
# .secrets/konflux/token). Rotate by updating that file in place; no restart needed.
KONFLUX_API_URL=https://api.kflux-rhel-p01.fc38.p1.openshiftapps.com:6443
# Production archive 404 fallback. If KONFLUX_API_URL targets another cluster,
# set this to that cluster's archive or leave it blank to disable the fallback.
KUBEARCHIVE_API_URL=https://kubearchive-api-server-product-kubearchive.apps.kflux-rhel-p01.fc38.p1.openshiftapps.com
KONFLUX_PIPELINE_URL=https://gitlab.cee.redhat.com/rhel-on-konflux/rpmbuild-pipeline.git
